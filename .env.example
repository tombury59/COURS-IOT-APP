# Copie ce fichier en `.env` (non commite) et remplis les valeurs.
# Expo charge automatiquement les variables prefixees EXPO_PUBLIC_ dans le bundle JS.
#
# ATTENTION securite (chapitre 6) : une variable EXPO_PUBLIC_ est EMBARQUEE
# en clair dans le bundle de l'app. Le .env sert surtout a NE PAS commiter
# les identifiants dans git. Pour un vrai secret, il faudrait un back-end
# qui proxyfie la connexion. Pour ce projet de cours, c'est acceptable.

# --- Broker : public (par defaut) ou cloud ---
# Mettre "true" pour utiliser le broker cloud, sinon broker public broker.hivemq.com
EXPO_PUBLIC_USE_CLOUD=false

# URL complete du broker cloud en WebSocket securise (wss), port + chemin inclus.
# Fournie par le binome. Ex EMQX Serverless : wss://xxxx.emqxsl.com:8084/mqtt
EXPO_PUBLIC_BROKER_URL=

# Identifiants de l'app sur le broker cloud (utilisateur app-frigo)
EXPO_PUBLIC_CLOUD_USERNAME=app-frigo
EXPO_PUBLIC_CLOUD_PASSWORD=

# Base des topics = ce qui precede /temperature et /status (ex: frigo/1)
EXPO_PUBLIC_TOPIC_BASE=frigo/1
